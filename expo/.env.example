# Copy to .env for local runs. Expo inlines every EXPO_PUBLIC_* value into the
# JavaScript bundle at build time, so these are public by definition — never put
# a secret here.

# Supabase project — sign-in, password reset, gratitude journal, image upload.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the AI proxy (expo/backend/ai/server.mjs), e.g. https://ai.example.com.
# The provider key stays on that server as AI_API_KEY and must never carry the
# EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_AI_API_URL=
